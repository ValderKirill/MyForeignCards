    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>26f17d84-a618-4ee9-a71f-99a6129cdf60</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="wwwroot\index.html">
